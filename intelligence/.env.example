# VEKTOR Intelligence Brain — Environment Configuration

# Production Vision Inference Endpoint (e.g. deployed Ollama or cloud vision gateway)
# Default for local dev: http://localhost:11434/api/generate
VISION_INFERENCE_URL=http://localhost:11434/api/generate

# Vision model name
VISION_MODEL=qwen2.5vl:3b

# Optional API key / Bearer token if connecting to an authenticated remote endpoint
# VISION_API_KEY=your_bearer_token_here

# Timeouts in seconds
VISION_TIMEOUT_SECONDS=25.0
VISION_CONNECT_TIMEOUT_SECONDS=5.0
