# VEKTOR Intelligence Brain — Environment Configuration

# ----------------------------------------------------------------------------
# Vision Provider Selection ('gemini' for production, 'ollama' for local dev)
# ----------------------------------------------------------------------------
VISION_PROVIDER=gemini

# ----------------------------------------------------------------------------
# Google Gemini Vision Configuration (Production Default)
# ----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ----------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (Sentinel-2 Satellite Imagery)
# ----------------------------------------------------------------------------
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here

# ----------------------------------------------------------------------------
# Optional Ollama Configuration (Local Development)
# ----------------------------------------------------------------------------
# VISION_INFERENCE_URL=http://localhost:11434/api/generate
# VISION_MODEL=qwen2.5vl:3b
# VISION_TIMEOUT_SECONDS=25.0
# VISION_CONNECT_TIMEOUT_SECONDS=5.0
